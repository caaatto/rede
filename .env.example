# Rede Client Configuration
# Copy this file to .env and adjust values
#
# TLS Setup (required for wss://):
#   mkdir -p certs
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
#     -keyout certs/key.pem -out certs/cert.pem -days 365 -nodes -subj "/CN=rede"

# Server connection
REDE_SERVER=wss://localhost:9377

# Transport (uncomment ONE if needed)
#REDE_TRANSPORT=i2p
#REDE_TRANSPORT=tor

# Proxy settings (defaults shown)
#REDE_TOR_PROXY=socks5h://127.0.0.1:9050
#REDE_I2P_PROXY=socks5h://127.0.0.1:4447

# Profile passphrase (WARNING: visible in /proc — prefer interactive prompt)
#REDE_PASS=
