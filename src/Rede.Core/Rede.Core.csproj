<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="1.4.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- RNNoise native library for noise suppression -->
  <ItemGroup>
    <Content Include="runtimes\linux-x64\native\librnnoise.so" Link="runtimes\linux-x64\native\librnnoise.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes\win-x64\native\rnnoise.dll" Link="runtimes\win-x64\native\rnnoise.dll" Condition="Exists('runtimes\win-x64\native\rnnoise.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
