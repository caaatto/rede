<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Sodium.Core" Version="1.4.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- RNNoise native libraries are NOT bundled with the app.
       Users install them separately via scripts/install-rnnoise.sh or .ps1
       which places them in ~/.rede/libs/. The resolver probes that path at runtime. -->

</Project>
