<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             xmlns:local="using:Rede.Desktop.Converters"
             xmlns:controls="using:Rede.Desktop.Controls"
             x:Class="Rede.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.settings-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.settings-nav ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RedeTextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.settings-nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedeSurfaceBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource RedeTextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedeAccentVioletBrush}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="ListBox.settings-nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RedeAccentVioletBrush}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource RedeSurfaceBrush}">
    <Grid RowDefinitions="Auto,*" Margin="0,36,0,0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="24,0,24,16">
            <Button Grid.Column="0" Classes="ghost"
                    Content="← Back"
                    Command="{Binding BackCommand}"
                    Padding="8,4" />
            <TextBlock Grid.Column="1"
                       Text="Settings"
                       Classes="title"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <!-- spacer to balance Back button -->
            <Border Grid.Column="2" Width="60" />
        </Grid>

        <!-- Sidebar + Content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">

            <!-- Category Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource RedeBackgroundBrush}"
                    Padding="12,8">
                <ListBox Classes="settings-nav"
                         SelectedIndex="{Binding SelectedCategoryIndex}">
                    <ListBoxItem>
                        <TextBlock Text="Profile" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Appearance" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Presence" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Notifications" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Voice &amp; Audio" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Security" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="System" FontSize="{StaticResource RedeBodySize}" />
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Content area -->
            <!-- NOTE: the spacing around the content is a Margin on the inner Grid, NOT Padding on
                 the ScrollViewer. ScrollViewer.Padding is subtracted from the scrollable extent in
                 Avalonia, which clipped the bottom ~32px (the last controls were unreachable). -->
            <ScrollViewer Grid.Column="1" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,8,32,24"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <!-- =========================================================== -->
                    <!-- PROFILE Category                                             -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="0" Spacing="24" IsVisible="{Binding IsProfileCategory}">

                        <!-- Avatar + Identity -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Profile" Classes="header" />
                            <Grid ColumnDefinitions="Auto,16,*">
                                <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                                    <Border Width="88" Height="88" CornerRadius="44"
                                            Background="{Binding AccentBrush}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center">
                                        <Panel>
                                            <TextBlock Text="{Binding AvatarInitial}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasAvatar}" />
                                            <Image Source="{Binding AvatarImage}"
                                                   Width="88" Height="88"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding HasAvatar}" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Button Classes="ghost" Content="Upload"
                                                Padding="8,3" FontSize="11"
                                                Command="{Binding PickAvatarCommand}" />
                                        <Button Classes="ghost" Content="Remove"
                                                Padding="8,3" FontSize="11"
                                                Foreground="{DynamicResource RedeErrorBrush}"
                                                Command="{Binding RemoveAvatarCommand}"
                                                IsVisible="{Binding HasAvatar}" />
                                    </StackPanel>
                                    <TextBlock Text="PNG, JPEG, GIF (max 256KB)"
                                               Classes="muted" FontSize="10"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Classes="secondary" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserId}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name" Classes="secondary" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Device ID" Classes="secondary" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceId}" Margin="0,8,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Accent Color -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Accent Color" Classes="header" />
                            <TextBlock Text="Choose your profile accent color. Contacts will see your messages in this color."
                                       Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                            <WrapPanel x:Name="ColorPalette" Orientation="Horizontal" />
                            <Button Content="Apply"
                                    Command="{Binding ApplyProfileCommand}"
                                    IsEnabled="{Binding ProfileDirty}"
                                    HorizontalAlignment="Left"
                                    Padding="16,6"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- APPEARANCE Category                                          -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="1" Spacing="16" IsVisible="{Binding IsAppearanceCategory}">
                        <TextBlock Text="Appearance" Classes="header" />
                        <TextBlock Text="Choose a theme variant for the entire app. Changes apply instantly."
                                   Classes="secondary" TextWrapping="Wrap" FontSize="11" />

                        <Grid ColumnDefinitions="160,*">
                            <TextBlock Grid.Column="0" Text="Theme" Classes="secondary" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding SelectedThemeIndex}"
                                      MinWidth="220">
                                <ComboBoxItem Content="Dark (default)" />
                                <ComboBoxItem Content="Midnight" />
                                <ComboBoxItem Content="Dim" />
                                <ComboBoxItem Content="Light" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Dark - default near-black cinematic. Midnight - pure black, higher contrast. Dim - softer dark gray. Light - white/gray for bright environments."
                                   Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- PRESENCE Category                                            -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="2" Spacing="12" IsVisible="{Binding IsPresenceCategory}">
                        <TextBlock Text="Presence" Classes="header" />
                        <TextBlock Text="Set your presence status. Contacts will see when you're online, away, or busy."
                                   Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Classes="secondary" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      SelectedIndex="{Binding SelectedStatusIndex}"
                                      MinWidth="200">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="#22c55e" VerticalAlignment="Center" />
                                        <TextBlock Text="Online" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="#eab308" VerticalAlignment="Center" />
                                        <TextBlock Text="Away" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="#ef4444" VerticalAlignment="Center" />
                                        <TextBlock Text="Do Not Disturb" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="#6b7280" VerticalAlignment="Center" />
                                        <TextBlock Text="Invisible" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Custom Status" Classes="secondary"
                                       VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CustomStatusText}"
                                     Watermark="What are you up to?"
                                     MaxLength="128"
                                     Margin="0,12,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- NOTIFICATIONS Category                                       -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="3" Spacing="12" IsVisible="{Binding IsNotificationsCategory}">
                        <TextBlock Text="Notifications" Classes="header" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Desktop Notifications"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          IsChecked="{Binding NotificationsEnabled}"
                                          OnContent="On" OffContent="Off" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Show Sender &amp; Content"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                          IsChecked="{Binding NotificationShowContent}"
                                          OnContent="On" OffContent="Off"
                                          Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Notification Sound"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                          IsChecked="{Binding NotificationSoundEnabled}"
                                          OnContent="On" OffContent="Off"
                                          Margin="0,8,0,0" />
                        </Grid>
                        <TextBlock Text="When 'Show Sender &amp; Content' is off (default), notifications only say 'New message' - no metadata is leaked to the OS notification system. Suppressed when status is Do Not Disturb."
                                   Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- VOICE & AUDIO Category                                       -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="4" Spacing="24" IsVisible="{Binding IsVoiceCategory}">

                        <!-- Voice Calls -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Voice Calls" Classes="header" />
                            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Transport" Classes="secondary" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding CallTransport}"
                                           Foreground="{DynamicResource RedeTextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="Voice calls use E2EE (SRTP) over your current transport. I2P/Tor: anonymous with higher latency. Direct: low latency, server sees your IP."
                                           Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Audio Devices -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Audio" Classes="header" />
                            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Microphone" Classes="secondary" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding InputDevices}"
                                          SelectedIndex="{Binding SelectedInputDeviceIndex}"
                                          MinWidth="220" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Speaker" Classes="secondary" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding OutputDevices}"
                                          SelectedIndex="{Binding SelectedOutputDeviceIndex}"
                                          MinWidth="220" Margin="0,12,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <Run Text="Mic Volume " /><Run Text="{Binding InputVolumeText}" />
                                </TextBlock>
                                <Slider Grid.Row="2" Grid.Column="1"
                                        Minimum="0" Maximum="200" Value="{Binding InputVolume}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,12,0,0" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="secondary" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <Run Text="Output Volume " /><Run Text="{Binding OutputVolumeText}" />
                                </TextBlock>
                                <Slider Grid.Row="3" Grid.Column="1"
                                        Minimum="0" Maximum="200" Value="{Binding OutputVolume}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,12,0,0" />
                            </Grid>

                            <TextBlock Text="Volumes above 100% amplify the signal."
                                       Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>

                        <Separator />

                        <!-- Input Sensitivity -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Input Sensitivity" Classes="header" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoInputSensitivity}"
                                              OnContent="On" OffContent="Off"
                                              VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Automatically Adjust Input Sensitivity" VerticalAlignment="Center" />
                                    <TextBlock Text="Adapts to your environment so you don't have to manually set a threshold."
                                               Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Noise Gate slider (manual mode) -->
                            <StackPanel Spacing="4" IsVisible="{Binding !AutoInputSensitivity}">
                                <TextBlock Classes="secondary">
                                    <Run Text="Noise Gate " /><Run Text="{Binding NoiseGateText}" />
                                </TextBlock>
                                <!-- dB scale: -100 (silent) to 0 (max) -->
                                <Grid ColumnDefinitions="40,*,30">
                                    <TextBlock Grid.Column="0" Text="-100" Classes="secondary" FontSize="10" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="-100" Maximum="0" Value="{Binding NoiseGateThreshold}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="2" Text="0 dB" Classes="secondary" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Audio below this level is muted. Slide left for more sensitivity, right for less."
                                           Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Input level meter -->
                            <Grid ColumnDefinitions="80,*" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="Input Level" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#1a1a2e" CornerRadius="4" Height="8" ClipToBounds="True">
                                    <Border Background="{DynamicResource RedeAccentTealBrush}" CornerRadius="4" Height="8"
                                            HorizontalAlignment="Left"
                                            Width="{Binding CurrentInputLevelDb, Converter={x:Static local:InputLevelConverter.Instance}}" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Voice Processing -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Voice Processing" Classes="header" />

                            <!-- Noise Suppression (RNNoise) -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding NoiseSuppression}"
                                              IsEnabled="{Binding IsNoiseSuppressionAvailable}"
                                              OnContent="On" OffContent="Off"
                                              VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Noise Suppression" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding NoiseSuppressionStatus}" Classes="secondary" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Install RNNoise"
                                                IsVisible="{Binding ShowRnnoiseInstall}"
                                                Click="InstallRnnoise_Click"
                                                FontSize="11" Padding="8,3"
                                                Foreground="{DynamicResource RedeAccentBrush}"
                                                Background="{DynamicResource RedeSurfaceBrush}"
                                                CornerRadius="4" />
                                        <TextBlock Text="{Binding RnnoiseInstallStatus}"
                                                   IsVisible="{Binding IsRnnoiseInstalling}"
                                                   Classes="secondary" FontSize="11"
                                                   Foreground="{DynamicResource RedeAccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Echo Cancellation -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding EchoCancellation}"
                                              OnContent="On" OffContent="Off"
                                              VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Echo Cancellation" VerticalAlignment="Center" />
                                    <TextBlock Text="Reduces feedback from speakers picked up by your mic."
                                               Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Automatic Gain Control -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoGainControl}"
                                              OnContent="On" OffContent="Off"
                                              VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Automatic Gain Control" VerticalAlignment="Center" />
                                    <TextBlock Text="Automatically adjusts mic volume to keep it clear and consistent."
                                               Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- SECURITY Category                                            -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="5" Spacing="24" IsVisible="{Binding IsSecurityCategory}">

                        <!-- Fingerprint -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Fingerprint" Classes="header" />
                            <TextBlock Text="Verify this fingerprint out-of-band to ensure secure communication."
                                       Classes="secondary" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource RedeBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <Grid RowDefinitions="Auto,8,Auto">
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Fingerprint}"
                                               FontFamily="Courier New, monospace"
                                               FontSize="15"
                                               Foreground="{DynamicResource RedeAccentVioletBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Row="2"
                                            Classes="ghost"
                                            Content="Copy"
                                            HorizontalAlignment="Center"
                                            Padding="16,4"
                                            FontSize="{StaticResource RedeSmallSize}"
                                            Click="CopyFingerprint_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Separator />

                        <!-- Public Key -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Public Key" Classes="header" />
                            <Border Background="{DynamicResource RedeBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <TextBlock Text="{Binding PublicKey}"
                                           FontFamily="Courier New, monospace"
                                           FontSize="11"
                                           Classes="secondary"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Separator />

                        <!-- Change Passphrase -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Change Passphrase" Classes="header" />
                            <TextBlock Text="Re-encrypts your profile and chat history with a new passphrase."
                                       Classes="secondary" TextWrapping="Wrap" FontSize="11" />

                            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current" Classes="secondary" VerticalAlignment="Center" />
                                <controls:SecureTextBox Grid.Row="0" Grid.Column="1"
                                                        x:Name="CurrentPassphraseBox"
                                                        Watermark="Current passphrase"
                                                        IsInputEnabled="{Binding !IsChangingPassphrase}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="New" Classes="secondary" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <controls:SecureTextBox Grid.Row="1" Grid.Column="1"
                                                        x:Name="NewPassphraseBox"
                                                        Watermark="New passphrase"
                                                        Margin="0,8,0,0"
                                                        IsInputEnabled="{Binding !IsChangingPassphrase}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Confirm" Classes="secondary" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <controls:SecureTextBox Grid.Row="2" Grid.Column="1"
                                                        x:Name="ConfirmPassphraseBox"
                                                        Watermark="Confirm new passphrase"
                                                        Margin="0,8,0,0"
                                                        IsInputEnabled="{Binding !IsChangingPassphrase}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Change Passphrase"
                                        Click="ChangePassphrase_Click"
                                        IsEnabled="{Binding !IsChangingPassphrase}"
                                        Padding="16,6" />
                                <TextBlock Text="{Binding PassphraseChangeStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Separator />

                        <!-- Security Keys (FIDO2) -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Security Keys (FIDO2)" Classes="header" />
                            <TextBlock Text="Require a hardware security key (plus your passphrase) to unlock this profile. Enroll a backup key and generate a recovery code so you are never locked out."
                                       Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding FidoDiagnostics}"
                                       IsVisible="{Binding FidoDiagnostics, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Classes="secondary" FontSize="11" FontFamily="Courier New, monospace" />

                            <!-- Install native support (when libfido2 is not loaded) -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowFidoInstall}">
                                <TextBlock Text="Security-key support isn't loaded. On Linux install the system library (e.g. sudo apt install libfido2-1), then reopen Settings. On Windows it's built in."
                                           Classes="secondary" TextWrapping="Wrap" FontSize="11" />
                                <Button Content="Install security-key support"
                                        Command="{Binding InstallFido2Command}"
                                        IsEnabled="{Binding !IsFidoBusy}"
                                        HorizontalAlignment="Left"
                                        Padding="16,6" />
                            </StackPanel>

                            <!-- Status / progress — always visible so install failures aren't silent -->
                            <TextBlock Text="{Binding FidoStatus}"
                                       IsVisible="{Binding FidoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource RedeAccentTealBrush}"
                                       FontSize="12" TextWrapping="Wrap" />

                            <!-- Enrolled keys list -->
                            <ItemsControl ItemsSource="{Binding SecurityKeys}" IsVisible="{Binding HasSecurityKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource RedeBackgroundBrush}"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Added}" Classes="secondary" FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="ghost" Content="Remove"
                                                        Padding="12,4" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveSecurityKeyCommand}"
                                                        CommandParameter="{Binding CredentialId}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Enroll a new key -->
                            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto"
                                  IsVisible="{Binding FidoBackendAvailable}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Key name" Classes="secondary" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FidoKeyNameBox"
                                         Watermark="e.g. Thetis Pro" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Key PIN (if set)" Classes="secondary" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FidoPinBox"
                                         PasswordChar="•" Watermark="Security-key PIN" Margin="0,8,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding FidoBackendAvailable}">
                                <Button Content="Enroll security key"
                                        Click="EnrollSecurityKey_Click"
                                        IsEnabled="{Binding !IsFidoBusy}"
                                        Padding="16,6" />
                                <Button Content="Generate recovery code"
                                        Click="GenerateRecovery_Click"
                                        IsEnabled="{Binding HasSecurityKeys}"
                                        Classes="ghost"
                                        Padding="16,6" />
                            </StackPanel>

                            <!-- One-time recovery code display -->
                            <Border Background="{DynamicResource RedeBackgroundBrush}" CornerRadius="8" Padding="16,12"
                                    IsVisible="{Binding GeneratedRecoveryCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Recovery code (shown once)" Classes="secondary" FontSize="11" />
                                    <SelectableTextBlock Text="{Binding GeneratedRecoveryCode}"
                                                         FontFamily="Courier New, monospace" FontSize="15"
                                                         Foreground="{DynamicResource RedeAccentTealBrush}"
                                                         TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- =========================================================== -->
                    <!-- SYSTEM Category                                              -->
                    <!-- =========================================================== -->
                    <StackPanel Grid.Row="6" Spacing="16" IsVisible="{Binding IsSystemCategory}">
                        <TextBlock Text="System" Classes="header" />
                        <TextBlock Text="Control how Rede integrates with your operating system."
                                   Classes="secondary" TextWrapping="Wrap" FontSize="11" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="Minimize to system tray" VerticalAlignment="Center" />
                                <TextBlock Text="Pressing the close (X) button hides Rede to the tray instead of quitting."
                                           Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          IsChecked="{Binding MinimizeToTray}"
                                          OnContent="On" OffContent="Off"
                                          VerticalAlignment="Center" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                                <TextBlock Text="Launch on system startup" VerticalAlignment="Center" />
                                <TextBlock Text="Rede starts automatically when you log into your computer."
                                           Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                          IsChecked="{Binding AutostartEnabled}"
                                          IsEnabled="{Binding IsAutostartSupported}"
                                          OnContent="On" OffContent="Off"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Center" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                                <TextBlock Text="Start minimized to tray" VerticalAlignment="Center" />
                                <TextBlock Text="When launched from autostart, skip the window and go straight to the tray."
                                           Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                          IsChecked="{Binding StartMinimized}"
                                          IsEnabled="{Binding AutostartEnabled}"
                                          OnContent="On" OffContent="Off"
                                          Margin="0,12,0,0"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Border>
</UserControl>
