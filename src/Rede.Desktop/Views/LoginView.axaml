<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             x:Class="Rede.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- Centered login panel on dark background -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,36,0,24">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource RedeSurfaceBrush}"
                BorderBrush="{StaticResource RedeBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,18"
                BoxShadow="0 8 32 0 #20000000">
            <StackPanel Spacing="10">

                <!-- Logo / Title -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="rede"
                               Classes="title"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource RedeAccentVioletBrush}" />
                    <TextBlock Text="secure messenger"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="0,2" />

                <!-- Mode tabs -->
                <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding !IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Login"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding IsRegisterMode}" />
                    </Border>
                    <Border Grid.Column="1"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Register"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding !IsRegisterMode}" />
                    </Border>
                </Grid>

                <!-- === LOGIN MODE: single column === -->
                <StackPanel Spacing="10" IsVisible="{Binding !IsRegisterMode}" Width="320">

                    <!-- User ID -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="User ID" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <TextBox Text="{Binding UserId}"
                                 Watermark="{Binding UserIdWatermark}"
                                 MaxLength="255"
                                 IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- Passphrase -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Passphrase" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <TextBox Text="{Binding Passphrase}"
                                 PasswordChar="*"
                                 Watermark="min 12 characters"
                                 IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- Server -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Server" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <ComboBox ItemsSource="{Binding ServerOptions}"
                                  SelectedItem="{Binding SelectedServer}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsLoading}" />
                        <TextBlock Text="Deine IP-Adresse ist bei direkter Verbindung für den Server sichtbar."
                                   Foreground="{StaticResource RedeWarningBrush}"
                                   FontSize="{StaticResource RedeSmallSize}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsDirectTransport}" />
                    </StackPanel>

                    <!-- Login button -->
                    <Button Content="Login"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- === REGISTER MODE: two columns === -->
                <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding IsRegisterMode}" Width="520">

                    <!-- Left column: identity -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Display Name" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding UserId}"
                                     Watermark="{Binding UserIdWatermark}"
                                     MaxLength="255"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Passphrase" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding Passphrase}"
                                     PasswordChar="*"
                                     Watermark="min 12 characters"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Confirm Passphrase" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding PassphraseConfirm}"
                                     PasswordChar="*"
                                     Watermark="repeat passphrase"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: connection -->
                    <StackPanel Grid.Column="2" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <ComboBox ItemsSource="{Binding ServerOptions}"
                                      SelectedItem="{Binding SelectedServer}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsLoading}" />
                            <TextBlock Text="Deine IP-Adresse ist bei direkter Verbindung für den Server sichtbar."
                                       Foreground="{StaticResource RedeWarningBrush}"
                                       FontSize="{StaticResource RedeSmallSize}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsDirectTransport}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Invite Code" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding InviteCode}"
                                     Watermark="required for registration"
                                     MaxLength="128"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Register button (centered below both columns) -->
                <Button Content="Register"
                        Command="{Binding RegisterCommand}"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        MinWidth="200"
                        IsVisible="{Binding IsRegisterMode}"
                        IsEnabled="{Binding !IsLoading}" />

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource RedeErrorBrush}"
                           FontSize="{StaticResource RedeSmallSize}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding IsLoading}">
                    <TextBlock Text="Connecting..."
                               Classes="secondary"
                               Foreground="{StaticResource RedeAccentVioletBrush}" />
                </StackPanel>

                <!-- Update status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="secondary"
                           FontSize="{StaticResource RedeSmallSize}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource RedeAccentTealBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="StatusMessage" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                            <Binding Path="!IsUpdateAvailable" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Update button -->
                <Button Content="{Binding StatusMessage}"
                        Command="{Binding TriggerUpdateCommand}"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource RedeSmallSize}"
                        Background="Transparent"
                        Foreground="{StaticResource RedeAccentTealBrush}"
                        Cursor="Hand"
                        Padding="8,4"
                        IsVisible="{Binding IsUpdateAvailable}" />

            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
