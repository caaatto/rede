<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             x:Class="Rede.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- Centered login panel on dark background -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,36,0,24">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
        <Border Background="{StaticResource RedeSurfaceBrush}"
                BorderBrush="{StaticResource RedeBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32,24"
                BoxShadow="0 8 32 0 #20000000">
            <StackPanel Spacing="16">

                <!-- Logo / Title -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="rede"
                               Classes="title"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource RedeAccentVioletBrush}" />
                    <TextBlock Text="secure messenger"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="0,4" />

                <!-- Mode tabs -->
                <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding !IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Login"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding IsRegisterMode}" />
                    </Border>
                    <Border Grid.Column="1"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Register"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding !IsRegisterMode}" />
                    </Border>
                </Grid>

                <!-- User ID (login) / Display Name (register) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="User ID" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}"
                               IsVisible="{Binding !IsRegisterMode}" />
                    <TextBlock Text="Display Name" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}"
                               IsVisible="{Binding IsRegisterMode}" />
                    <TextBox Text="{Binding UserId}"
                             Watermark="{Binding UserIdWatermark}"
                             MaxLength="255"
                             IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- Passphrase -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Passphrase" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}" />
                    <TextBox Text="{Binding Passphrase}"
                             PasswordChar="*"
                             Watermark="min 12 characters"
                             IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- Confirm Passphrase (register mode only) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <TextBlock Text="Confirm Passphrase" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}" />
                    <TextBox Text="{Binding PassphraseConfirm}"
                             PasswordChar="*"
                             Watermark="repeat passphrase"
                             IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- Invite Code (register mode only) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <TextBlock Text="Invite Code" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}" />
                    <TextBox Text="{Binding InviteCode}"
                             Watermark="required for registration"
                             MaxLength="128"
                             IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- Server -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Server" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightMedium}" />
                    <ComboBox ItemsSource="{Binding ServerOptions}"
                              SelectedItem="{Binding SelectedServer}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !IsLoading}" />
                    <TextBlock Text="Deine IP-Adresse ist bei direkter Verbindung für den Server sichtbar."
                               Foreground="{StaticResource RedeWarningBrush}"
                               FontSize="{StaticResource RedeSmallSize}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsDirectTransport}" />
                </StackPanel>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource RedeErrorBrush}"
                           FontSize="{StaticResource RedeSmallSize}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- Login button (login mode) -->
                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsVisible="{Binding !IsRegisterMode}"
                        IsEnabled="{Binding !IsLoading}" />

                <!-- Register button (register mode) -->
                <Button Content="Register"
                        Command="{Binding RegisterCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsVisible="{Binding IsRegisterMode}"
                        IsEnabled="{Binding !IsLoading}" />

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding IsLoading}">
                    <TextBlock Text="Connecting..."
                               Classes="secondary"
                               Foreground="{StaticResource RedeAccentVioletBrush}" />
                </StackPanel>

                <!-- Update status (text, hidden when clickable button is shown instead) -->
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="secondary"
                           FontSize="{StaticResource RedeSmallSize}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource RedeAccentTealBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="StatusMessage" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                            <Binding Path="!IsUpdateAvailable" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Update button (standalone exe) -->
                <Button Content="{Binding StatusMessage}"
                        Command="{Binding TriggerUpdateCommand}"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource RedeSmallSize}"
                        Background="Transparent"
                        Foreground="{StaticResource RedeAccentTealBrush}"
                        Cursor="Hand"
                        Padding="8,4"
                        IsVisible="{Binding IsUpdateAvailable}" />

            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
