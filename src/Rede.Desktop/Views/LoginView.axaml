<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             xmlns:ctrls="using:Rede.Desktop.Controls"
             x:Class="Rede.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <!-- Pulsing glow ring behind the key icon — the visual "tap your key now"
             cue shown while the security-key gate waits for a hardware touch. -->
        <Style Selector="Border.touchPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25" />
                        <Setter Property="RenderTransform" Value="scale(0.8)" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.75" />
                        <Setter Property="RenderTransform" Value="scale(1.15)" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25" />
                        <Setter Property="RenderTransform" Value="scale(0.8)" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Centered login panel on dark background -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,36,0,24">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,18"
                BoxShadow="0 8 32 0 #20000000">
            <StackPanel Spacing="10">

                <!-- Logo / Title -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="rede"
                               Classes="title"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource RedeAccentVioletBrush}" />
                    <TextBlock Text="secure messenger"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="0,2" />

                <!-- === QUICK LOGIN MODE (profile hint exists) === -->
                <StackPanel Spacing="10" Width="320">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasQuickLogin" />
                            <Binding Path="!IsAwaitingSecurityKey" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Text="Welcome back"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Passphrase" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <ctrls:SecureTextBox x:Name="QuickPassphraseBox"
                                             Watermark="enter passphrase"
                                             IsInputEnabled="{Binding !IsLoading}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Server" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <ComboBox ItemsSource="{Binding ServerOptions}"
                                  SelectedItem="{Binding SelectedServer}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>
                    <CheckBox Content="Stay signed in"
                              IsChecked="{Binding StaySignedIn}"
                              IsEnabled="{Binding !IsLoading}" />
                    <Button Content="Unlock"
                            x:Name="QuickLoginButton"
                            Click="OnQuickLoginClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !IsLoading}" />
                    <Button Content="Use different account"
                            Classes="ghost"
                            Command="{Binding UseDifferentAccountCommand}"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource RedeSmallSize}"
                            Padding="8,4"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- === SECURITY KEY UNLOCK GATE === -->
                <StackPanel Spacing="12" Width="320" IsVisible="{Binding IsAwaitingSecurityKey}">

                    <!-- Animated touch prompt: a pulsing key icon tells the user to
                         physically tap their security key. Hidden in recovery-code mode,
                         where no hardware tap is required. -->
                    <Panel Height="96" IsVisible="{Binding !ShowRecoveryEntry}">
                        <Border Classes="touchPulse"
                                Width="88" Height="88" CornerRadius="44"
                                Background="{DynamicResource RedeGlowTealBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Width="60" Height="60" CornerRadius="30"
                                Background="{DynamicResource RedeSurfaceActiveBrush}"
                                BorderBrush="{DynamicResource RedeAccentTealBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{StaticResource IconLock}" Width="28" Height="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <TextBlock Text="Security key required"
                               HorizontalAlignment="Center"
                               FontWeight="{StaticResource RedeWeightMedium}"
                               Foreground="{DynamicResource RedeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding SecurityKeyStatus}"
                               Classes="secondary" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />

                    <!-- PIN (only if the key has one set) -->
                    <StackPanel Spacing="4" IsVisible="{Binding NeedsPin}">
                        <TextBlock Text="Security-key PIN" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <TextBox Text="{Binding KeyPin}" PasswordChar="•" Watermark="key PIN" />
                    </StackPanel>

                    <Button Content="Unlock with security key"
                            Command="{Binding RetrySecurityKeyCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            IsVisible="{Binding !ShowRecoveryEntry}" />

                    <Button Content="Use recovery code instead" Classes="ghost"
                            Command="{Binding ToggleRecoveryEntryCommand}"
                            HorizontalAlignment="Center" FontSize="{StaticResource RedeSmallSize}"
                            Padding="8,4" IsVisible="{Binding !ShowRecoveryEntry}" />

                    <StackPanel Spacing="6" IsVisible="{Binding ShowRecoveryEntry}">
                        <TextBlock Text="Recovery code" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <TextBox Text="{Binding RecoveryCode}" Watermark="XXXX-XXXX-…" />
                        <Button Content="Unlock with recovery code"
                                Command="{Binding SubmitRecoveryCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="Use security key instead" Classes="ghost"
                                Command="{Binding ToggleRecoveryEntryCommand}"
                                HorizontalAlignment="Center" FontSize="{StaticResource RedeSmallSize}"
                                Padding="8,4" />
                    </StackPanel>

                    <Button Content="Cancel" Classes="ghost"
                            Command="{Binding CancelFidoCommand}"
                            HorizontalAlignment="Center" FontSize="{StaticResource RedeSmallSize}"
                            Padding="8,4" />
                </StackPanel>

                <!-- Mode tabs (hidden in quick-login mode) -->
                <Grid ColumnDefinitions="*,*">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasQuickLogin" />
                            <Binding Path="!IsAwaitingSecurityKey" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <Border Grid.Column="0"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding !IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Login"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding IsRegisterMode}" />
                    </Border>
                    <Border Grid.Column="1"
                            BorderThickness="0,0,0,2"
                            Padding="0,0,0,8"
                            BorderBrush="{Binding IsRegisterMode, Converter={StaticResource StatusColorConverter}}">
                        <Button Content="Register"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost"
                                BorderThickness="0"
                                Command="{Binding ToggleModeCommand}"
                                IsEnabled="{Binding !IsRegisterMode}" />
                    </Border>
                </Grid>

                <!-- === LOGIN MODE: single column === -->
                <StackPanel Spacing="10" Width="320">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsRegisterMode" />
                            <Binding Path="!HasQuickLogin" />
                            <Binding Path="!IsAwaitingSecurityKey" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </StackPanel.IsVisible>

                    <!-- User ID -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="User ID" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <TextBox Text="{Binding UserId}"
                                 Watermark="{Binding UserIdWatermark}"
                                 MaxLength="255"
                                 IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- Passphrase -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Passphrase" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <ctrls:SecureTextBox x:Name="LoginPassphraseBox"
                                             Watermark="min 12 characters"
                                             IsInputEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- Server -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Server" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightMedium}" />
                        <ComboBox ItemsSource="{Binding ServerOptions}"
                                  SelectedItem="{Binding SelectedServer}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsLoading}" />
                        <TextBlock Text="Deine IP-Adresse ist bei direkter Verbindung für den Server sichtbar."
                                   Foreground="{DynamicResource RedeWarningBrush}"
                                   FontSize="{StaticResource RedeSmallSize}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsDirectTransport}" />
                    </StackPanel>

                    <CheckBox Content="Stay signed in"
                              IsChecked="{Binding StaySignedIn}"
                              IsEnabled="{Binding !IsLoading}" />

                    <!-- Login button -->
                    <Button Content="Login"
                            x:Name="LoginButton"
                            Click="OnLoginClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

                <!-- === REGISTER MODE: two columns === -->
                <Grid ColumnDefinitions="*,16,*" Width="520">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsRegisterMode" />
                            <Binding Path="!HasQuickLogin" />
                            <Binding Path="!IsAwaitingSecurityKey" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </Grid.IsVisible>

                    <!-- Left column: identity -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Display Name" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding UserId}"
                                     Watermark="{Binding UserIdWatermark}"
                                     MaxLength="255"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Passphrase" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <ctrls:SecureTextBox x:Name="RegisterPassphraseBox"
                                                 Watermark="min 12 characters"
                                                 IsInputEnabled="{Binding !IsLoading}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Confirm Passphrase" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <ctrls:SecureTextBox x:Name="RegisterPassphraseConfirmBox"
                                                 Watermark="repeat passphrase"
                                                 IsInputEnabled="{Binding !IsLoading}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: connection -->
                    <StackPanel Grid.Column="2" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <ComboBox ItemsSource="{Binding ServerOptions}"
                                      SelectedItem="{Binding SelectedServer}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsLoading}" />
                            <TextBlock Text="Deine IP-Adresse ist bei direkter Verbindung für den Server sichtbar."
                                       Foreground="{DynamicResource RedeWarningBrush}"
                                       FontSize="{StaticResource RedeSmallSize}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsDirectTransport}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Invite Code" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightMedium}" />
                            <TextBox Text="{Binding InviteCode}"
                                     Watermark="required for registration"
                                     MaxLength="128"
                                     IsEnabled="{Binding !IsLoading}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Register button (centered below both columns) -->
                <Button Content="Register"
                        x:Name="RegisterButton"
                        Click="OnRegisterClick"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        MinWidth="200"
                        IsEnabled="{Binding !IsLoading}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsRegisterMode" />
                            <Binding Path="!HasQuickLogin" />
                            <Binding Path="!IsAwaitingSecurityKey" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource RedeErrorBrush}"
                           FontSize="{StaticResource RedeSmallSize}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding IsLoading}">
                    <TextBlock Text="Connecting..."
                               Classes="secondary"
                               Foreground="{DynamicResource RedeAccentVioletBrush}" />
                </StackPanel>

                <!-- Update status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="secondary"
                           FontSize="{StaticResource RedeSmallSize}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource RedeAccentTealBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="StatusMessage" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                            <Binding Path="!IsUpdateAvailable" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Update button -->
                <Button Content="{Binding StatusMessage}"
                        Command="{Binding TriggerUpdateCommand}"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource RedeSmallSize}"
                        Background="Transparent"
                        Foreground="{DynamicResource RedeAccentTealBrush}"
                        Cursor="Hand"
                        Padding="8,4"
                        IsVisible="{Binding IsUpdateAvailable}" />

            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
