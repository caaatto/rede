<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:AvaloniaWebView;assembly=Avalonia.WebView"
        x:Class="Rede.Desktop.Views.GroupCallWindow"
        Title="Rede Call"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="480"
        Background="#0a0a0f"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <wv:WebView x:Name="WebView" />

        <!-- Fallback overlay shown until the WebView loads the page -->
        <Border x:Name="LoadingOverlay"
                Background="#0a0a0f"
                IsVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="connecting to call…"
                           Foreground="#8b5cf6"
                           FontSize="18"
                           FontWeight="600"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingDetail"
                           Text="requesting token"
                           Foreground="#8a8a9a"
                           FontSize="13"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
