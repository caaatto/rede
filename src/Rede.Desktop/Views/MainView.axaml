<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             xmlns:controls="using:Rede.Desktop.Controls"
             x:Class="Rede.Desktop.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Panel>
    <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
                Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidthConverter}}"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand header — logo + REDE wordmark (inside titlebar area) -->
                <Border DockPanel.Dock="Top" Height="44" Padding="14,8,8,6"
                        Background="{DynamicResource RedeSurfaceBrush}">
                    <Grid ColumnDefinitions="Auto,10,*,Auto">
                        <Image Grid.Column="0"
                               Source="avares://Rede.Desktop/Assets/icon.png"
                               Width="28" Height="28"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="REDE"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="{StaticResource RedeWeightBold}"
                                   Foreground="{DynamicResource RedeTextPrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                        <Button Grid.Column="3" Classes="ghost"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="4" Margin="0"
                                Width="28" Height="28"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSidebarCollapsed, Converter={StaticResource CollapseIconConverter}}"
                                       FontSize="14" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Search bar -->
                <Border DockPanel.Dock="Top" Padding="10,6,10,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <TextBox Text="{Binding SearchText}"
                             Watermark="Search..."
                             FontSize="{StaticResource RedeSmallSize}"
                             Padding="10,5"
                             MinHeight="0" />
                </Border>

                <!-- Retry row (only visible when disconnected) -->
                <Border DockPanel.Dock="Top" Padding="10,0,10,6"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        IsVisible="{Binding !IsConnected}">
                    <Button Classes="ghost"
                            Content="Reconnect"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="8,4"
                            FontSize="{StaticResource RedeSmallSize}"
                            Foreground="{DynamicResource RedeAccentVioletBrush}"
                            Click="RetryConnection_Click" />
                </Border>

                <!-- User profile panel (bottom of sidebar, like Discord) -->
                <Border DockPanel.Dock="Bottom" Padding="8,6"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Background="#0cffffff">
                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                        <!-- Avatar with status dot -->
                        <Panel Grid.Column="0" Width="40" Height="40">
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{Binding OwnAccentBrush}"
                                    ClipToBounds="True">
                                <Panel>
                                    <TextBlock Text="{Binding OwnInitial}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasOwnAvatar}" />
                                    <Image Source="{Binding OwnAvatarImage}"
                                           Width="40" Height="40"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasOwnAvatar}" />
                                </Panel>
                            </Border>
                            <Ellipse Width="12" Height="12"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Fill="{Binding OwnStatusBrush}"
                                     Stroke="{DynamicResource RedeSurfaceBrush}"
                                     StrokeThickness="2" />
                        </Panel>
                        <!-- Name + status text -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0"
                                    IsVisible="{Binding !IsSidebarCollapsed}">
                            <TextBlock Text="{Binding OwnDisplayName}"
                                       FontSize="{StaticResource RedeSmallSize}"
                                       FontWeight="{StaticResource RedeWeightMedium}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OwnStatusText}"
                                       Classes="muted"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Settings gear -->
                        <Button Grid.Column="3" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Settings"
                                VerticalAlignment="Center"
                                Click="Settings_Click">
                            <Image Source="{StaticResource IconGear}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable sidebar content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                <Separator />

                <!-- Contacts header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Contacts" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Add contact"
                                Click="AddContact_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Contact list -->
                    <ItemsControl ItemsSource="{Binding Contacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactItemViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8"
                                        Margin="2,1"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        IsVisible="{Binding IsMatch}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                        CommandParameter="{Binding}"
                                        PointerPressed="Contact_PointerPressed">
                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <!-- Avatar circle -->
                                        <Panel Grid.Column="0" Width="36" Height="36">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasAvatar}" />
                                                    <Image Source="{Binding AvatarImage}"
                                                           Width="36" Height="36"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding HasAvatar}" />
                                                </Panel>
                                            </Border>
                                            <!-- Status indicator -->
                                            <Ellipse Width="10" Height="10"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}"
                                                     ToolTip.Tip="{Binding StatusTooltip}" />
                                        </Panel>
                                        <!-- Name -->
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !$parent[Border].((vm:MainViewModel)DataContext).IsSidebarCollapsed, FallbackValue=True}" />
                                        <!-- Unread dot -->
                                        <Ellipse Grid.Column="3" Width="8" Height="8"
                                                 Fill="{DynamicResource RedeAccentVioletBrush}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding HasUnread}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Separator />

                <!-- Groups header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Groups" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Create group"
                                Click="CreateGroup_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Group list -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8"
                                        Margin="2,1"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        IsVisible="{Binding IsMatch}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                        CommandParameter="{Binding}"
                                        PointerPressed="Group_PointerPressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0">
                                            <Run Text="#" Foreground="{DynamicResource RedeTextMutedBrush}" />
                                            <Run Text="{Binding Name}" />
                                        </TextBlock>
                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                 Fill="{DynamicResource RedeAccentVioletBrush}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding HasUnread}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Separator />

                <!-- Places header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Places" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Create place"
                                Click="CreatePlace_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Place list with nested channels -->
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceItemViewModel">
                                <StackPanel IsVisible="{Binding IsMatch}">
                                    <!-- Place header -->
                                    <Button Classes="ghost"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,6"
                                            Margin="2,1"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Click="PlaceHeader_Click"
                                            PointerPressed="Place_PointerPressed">
                                        <Grid ColumnDefinitions="Auto,6,Auto,4,*,Auto,Auto">
                                            <!-- Place icon -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True" VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasIcon}" />
                                                    <Image Source="{Binding IconImage}"
                                                           Width="32" Height="32"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding HasIcon}" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding IsExpanded, Converter={StaticResource CollapseIconConverter}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource RedeTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4"
                                                       FontWeight="{StaticResource RedeWeightMedium}">
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding MemberCount, StringFormat={}{0}}"
                                                       Classes="muted"
                                                       FontSize="{StaticResource RedeCaptionSize}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <Ellipse Grid.Column="6" Width="8" Height="8"
                                                     Fill="{DynamicResource RedeAccentVioletBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0"
                                                     IsVisible="{Binding HasUnread}" />
                                        </Grid>
                                    </Button>
                                    <!-- Channels (visible when expanded) — grouped by category -->
                                    <ItemsControl ItemsSource="{Binding Channels}"
                                                  IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChannelItemViewModel">
                                                <Button Classes="ghost"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="24,6,12,6"
                                                        Margin="2,0"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Click="Channel_Click"
                                                        PointerPressed="Channel_PointerPressed">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0">
                                                            <Run Text="#" Foreground="{DynamicResource RedeTextMutedBrush}" />
                                                            <Run Text="{Binding Name}" />
                                                        </TextBlock>
                                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                                 Fill="{DynamicResource RedeAccentVioletBrush}"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding HasUnread}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===== CHAT AREA ===== -->
        <DockPanel Grid.Column="1">

            <!-- Chat header (extra top margin for title bar) -->
            <Border DockPanel.Dock="Top" Padding="16,12" Margin="0,30,0,0"
                    Background="{DynamicResource RedeSurfaceBrush}"
                    BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChatTitle}"
                                   Classes="header"
                                   IsVisible="{Binding ChatTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding ChannelTopic}"
                                   Classes="muted"
                                   FontSize="{StaticResource RedeCaptionSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"
                                   IsVisible="{Binding ChannelTopic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <!-- Member list toggle -->
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Toggle member list"
                            IsVisible="{Binding IsPlaceSelected}"
                            Click="ToggleMemberList_Click">
                        <TextBlock Text="&#x1D5E0;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Start voice call"
                            IsVisible="{Binding IsContactSelected}"
                            Click="CallContact_Click">
                        <Image Source="{StaticResource IconMicrophone}" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

            <!-- Call overlay (above input bar) -->
            <ContentControl DockPanel.Dock="Bottom"
                            x:Name="CallOverlay" />

            <!-- Reply preview bar + Message input bar -->
            <StackPanel DockPanel.Dock="Bottom">
                <!-- Reply preview (shown when replying) -->
                <Border Padding="16,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsReplying}">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Background="{DynamicResource RedeAccentBrush}" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding ReplyToAuthor, StringFormat='Replying to {0}'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RedeAccentBrush}" />
                            <TextBlock Text="{Binding ReplyToPreview}"
                                       FontSize="12"
                                       Foreground="{DynamicResource RedeSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="✕"
                                FontSize="14" Padding="6,2"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Command="{Binding CancelReplyCommand}" />
                    </Grid>
                </Border>
                <!-- Edit preview (shown when editing) -->
                <Border Padding="16,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsEditing}">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Background="{DynamicResource RedeAccentTealBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="Editing message"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RedeAccentTealBrush}" />
                        <Button Grid.Column="4" Content="✕"
                                FontSize="14" Padding="6,2"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Command="{Binding CancelEditCommand}" />
                    </Grid>
                </Border>
                <!-- Input bar -->
                <Border Padding="16,12"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Button Grid.Column="0"
                                Content="+"
                                FontSize="18" FontWeight="Bold"
                                Padding="8,4"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Click="AttachButton_Click"
                                ToolTip.Tip="Attach file" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding InputText}"
                                 Watermark="Type a message or /command..."
                                 MaxLength="4096"
                                 KeyDown="InputBox_KeyDown" />
                        <Button Grid.Column="4"
                                Content="Send"
                                Background="{Binding OwnAccentBrush}"
                                Foreground="White"
                                Command="{Binding SendMessageCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Messages area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="MessageScroller">
                <ItemsControl ItemsSource="{Binding Messages}" Padding="16,8"
                              VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Border Margin="0,2" Padding="0,4"
                                    Tag="{Binding}"
                                    PointerReleased="MessageItem_PointerReleased">
                                <Grid>
                                    <!-- Security alert (centered, warning color) -->
                                    <Border Background="#1af59e0b"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            HorizontalAlignment="Center"
                                            MaxWidth="500"
                                            IsVisible="{Binding IsSecurityAlert}">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource RedeWarningBrush}"
                                                   FontSize="{StaticResource RedeSmallSize}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- System message (centered) -->
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{DynamicResource RedeTextSecondaryBrush}"
                                               FontStyle="Italic"
                                               FontSize="{StaticResource RedeSmallSize}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsSystem}" />

                                    <!-- Incoming message (left) -->
                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,80,0"
                                                IsVisible="{Binding !IsOwn}">
                                        <!-- Sender avatar -->
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{Binding SenderAccentBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Top" Margin="0,20,0,0"
                                                IsVisible="{Binding !IsSystem}">
                                            <Panel>
                                                <TextBlock Text="{Binding SenderInitial}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSenderAvatar}" />
                                                <Image Source="{Binding SenderAvatar}"
                                                       Width="40" Height="40"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasSenderAvatar}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding !IsSystem}">
                                                <TextBlock Text="{Binding From}"
                                                           Foreground="{Binding SenderAccentBrush}"
                                                           FontWeight="{StaticResource RedeWeightSemiBold}"
                                                           FontSize="{StaticResource RedeBodySize}" />
                                                <!-- Role badge -->
                                                <Border CornerRadius="3"
                                                        Padding="5,2"
                                                        Background="{Binding RoleBadgeBrush}"
                                                        IsVisible="{Binding HasSenderRole}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SenderRole}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeString}"
                                                           Classes="muted"
                                                           FontSize="{StaticResource RedeCaptionSize}"
                                                           VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <!-- Reply quote -->
                                            <Border Background="{DynamicResource RedeBorderBrush}"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,0,0,2"
                                                    BorderThickness="2,0,0,0"
                                                    BorderBrush="{DynamicResource RedeAccentBrush}"
                                                    IsVisible="{Binding IsReply}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding ReplyToAuthor}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource RedeAccentBrush}" />
                                                    <TextBlock Text="{Binding ReplyToPreview}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource RedeSurfaceBrush}"
                                                    CornerRadius="4,12,12,12"
                                                    Padding="14,10"
                                                    IsVisible="{Binding !IsSystem}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="[message deleted]"
                                                               FontStyle="Italic"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}"
                                                               IsVisible="{Binding IsDeleted}" />
                                                    <controls:MarkdownTextBlock Markdown="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding !IsDeleted}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding IsEdited}">
                                                        <TextBlock Text="(edited)"
                                                                   FontSize="{StaticResource RedeCaptionSize}"
                                                                   Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                                IsVisible="{Binding HasTtl}">
                                                        <Image Source="{StaticResource IconClock}" Width="12" Height="12"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TtlDisplay}"
                                                                   Classes="muted"
                                                                   FontSize="{StaticResource RedeCaptionSize}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <!-- Attachments (incoming) -->
                                            <ItemsControl ItemsSource="{Binding Attachments}"
                                                          IsVisible="{Binding HasAttachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="8,6" Margin="0,4,0,0"
                                                                Background="{DynamicResource RedeSurfaceBrush}"
                                                                BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                BorderThickness="1"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                PointerReleased="AttachmentItem_Click">
                                                            <StackPanel Spacing="4">
                                                                <Image Source="{Binding Preview}"
                                                                       IsVisible="{Binding HasPreview}"
                                                                       MaxWidth="300" MaxHeight="200"
                                                                       Stretch="Uniform" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               Foreground="{DynamicResource RedeAccentBrush}" />
                                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="12"
                                                                               Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Reaction pills (incoming) -->
                                            <ItemsControl ItemsSource="{Binding Reactions}"
                                                          IsVisible="{Binding HasReactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10"
                                                                Padding="6,3"
                                                                Margin="0,2,4,0"
                                                                Background="{DynamicResource RedeSurfaceBrush}"
                                                                BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Emoji}" FontSize="13" />
                                                                <TextBlock Text="{Binding Count}" FontSize="12"
                                                                           Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Own message (right) -->
                                    <StackPanel Spacing="4"
                                                HorizontalAlignment="Right"
                                                Margin="80,0,0,0"
                                                IsVisible="{Binding IsOwn}">
                                        <!-- Reply quote (own) -->
                                        <Border Background="{DynamicResource RedeBorderBrush}"
                                                CornerRadius="4"
                                                Padding="10,6"
                                                Margin="0,0,0,2"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{DynamicResource RedeAccentBrush}"
                                                IsVisible="{Binding IsReply}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding ReplyToAuthor}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource RedeAccentBrush}" />
                                                <TextBlock Text="{Binding ReplyToPreview}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource RedeSurfaceActiveBrush}"
                                                CornerRadius="12,4,12,12"
                                                Padding="14,10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="[message deleted]"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                           IsVisible="{Binding IsDeleted}" />
                                                <controls:MarkdownTextBlock Markdown="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsDeleted}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding IsEdited}">
                                                    <TextBlock Text="(edited)"
                                                               FontSize="{StaticResource RedeCaptionSize}"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3"
                                                            IsVisible="{Binding HasTtl}">
                                                    <Image Source="{StaticResource IconClock}" Width="12" Height="12"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TtlDisplay}"
                                                               Classes="muted"
                                                               FontSize="{StaticResource RedeCaptionSize}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Attachments (own) -->
                                        <ItemsControl ItemsSource="{Binding Attachments}"
                                                      IsVisible="{Binding HasAttachments}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="8,6" Margin="0,4,0,0"
                                                            Background="{DynamicResource RedeSurfaceActiveBrush}"
                                                            BorderBrush="{DynamicResource RedeBorderBrush}"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            PointerReleased="AttachmentItem_Click">
                                                        <StackPanel Spacing="4">
                                                            <Image Source="{Binding Preview}"
                                                                   IsVisible="{Binding HasPreview}"
                                                                   MaxWidth="300" MaxHeight="200"
                                                                   Stretch="Uniform" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{DynamicResource RedeAccentBrush}" />
                                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="12"
                                                                           Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Reaction pills (own) -->
                                        <ItemsControl ItemsSource="{Binding Reactions}"
                                                      IsVisible="{Binding HasReactions}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10"
                                                            Padding="6,3"
                                                            Margin="0,2,4,0"
                                                            Background="{DynamicResource RedeSurfaceBrush}"
                                                            BorderBrush="{DynamicResource RedeBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Emoji}" FontSize="13" />
                                                            <TextBlock Text="{Binding Count}" FontSize="12"
                                                                       Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TimeString}"
                                                       Classes="muted"
                                                       FontSize="{StaticResource RedeCaptionSize}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

        <!-- ===== MEMBER LIST PANEL ===== -->
        <Border Grid.Column="2"
                Width="{Binding IsMemberListVisible, Converter={StaticResource SidebarWidthConverter}}"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                IsVisible="{Binding IsMemberListVisible}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="30" Background="Transparent" IsHitTestVisible="False" />
                <Border DockPanel.Dock="Top" Padding="12,8"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Members" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightSemiBold}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MemberList}" Padding="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceMemberViewModel">
                                <Border Padding="8,4" Margin="0,1" CornerRadius="4"
                                        PointerPressed="Member_PointerPressed">
                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <!-- Avatar -->
                                        <Panel Grid.Column="0" Width="32" Height="32">
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse Width="9" Height="9"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}" />
                                        </Panel>
                                        <!-- Name -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource RedeSmallSize}" />
                                        </StackPanel>
                                        <!-- Role badge -->
                                        <Border Grid.Column="3" CornerRadius="3"
                                                Padding="5,2" VerticalAlignment="Center"
                                                Background="{Binding RoleBrush}">
                                            <TextBlock Text="{Binding Role}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>

    </Panel>
</UserControl>
