<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             xmlns:controls="using:Rede.Desktop.Controls"
             x:Class="Rede.Desktop.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Panel>
    <DockPanel>

        <!-- ===== TOP PLACE RAIL =====
             Discord-style server bar, but rotated horizontal. Sits across the top of the
             window with REDE branding on the left, a Home/DMs button, the place icons,
             and an "add place" button. The selected place gets a Discord-style underline
             pill below the icon. The top 36px is left empty for OS title-bar drag. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="0,36,0,0" Height="64" ColumnDefinitions="Auto,Auto,Auto,*,Auto">

                <!-- Brand: logo + REDE wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" Margin="14,0,12,0">
                    <Image Source="avares://Rede.Desktop/Assets/icon.png"
                           Width="28" Height="28" />
                    <TextBlock Text="REDE"
                               FontSize="18"
                               FontWeight="{StaticResource RedeWeightBold}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Vertical separator -->
                <Border Grid.Column="1" Width="1" Margin="4,16"
                        Background="{DynamicResource RedeBorderBrush}" />

                <!-- Home / DMs (deselects active place, returns to contacts/groups view) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                    <Button Click="Home_Click"
                            Width="44" Height="44" Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="14"
                            ToolTip.Tip="Home (direct messages)">
                        <Border Width="44" Height="44"
                                CornerRadius="14"
                                Background="{DynamicResource RedeSurfaceActiveBrush}"
                                ClipToBounds="True">
                            <TextBlock Text="@"
                                       FontSize="20"
                                       FontWeight="{StaticResource RedeWeightSemiBold}"
                                       Foreground="{DynamicResource RedeTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <!-- Active underline pill — visible when no place is active. -->
                    <Border Height="3" Margin="8,2,8,0"
                            CornerRadius="2,2,0,0"
                            Background="{DynamicResource RedeAccentVioletBrush}"
                            IsVisible="{Binding !HasActivePlace}" />
                </StackPanel>

                <!-- Place icons (horizontally scrollable) -->
                <ScrollViewer Grid.Column="3"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="4,0">
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceItemViewModel">
                                <StackPanel VerticalAlignment="Center">
                                    <Button Width="44" Height="44" Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="14"
                                            Click="PlaceHeader_Click"
                                            PointerPressed="Place_PointerPressed"
                                            ToolTip.Tip="{Binding Name}">
                                        <Border Width="44" Height="44"
                                                Background="{Binding AccentBrush}"
                                                CornerRadius="14"
                                                ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="17" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasIcon}" />
                                                <Image Source="{Binding IconImage}"
                                                       Width="44" Height="44"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasIcon}" />
                                                <!-- Unread dot -->
                                                <Ellipse Width="10" Height="10"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Margin="0,3,3,0"
                                                         Fill="{DynamicResource RedeAccentVioletBrush}"
                                                         Stroke="{DynamicResource RedeSurfaceBrush}"
                                                         StrokeThickness="2"
                                                         IsVisible="{Binding HasUnread}" />
                                            </Panel>
                                        </Border>
                                    </Button>
                                    <!-- Active indicator — Discord-style underline pill. -->
                                    <Border Height="3" Margin="8,2,8,0"
                                            CornerRadius="2,2,0,0"
                                            Background="{DynamicResource RedeAccentVioletBrush}"
                                            IsVisible="{Binding IsExpanded}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add place -->
                <Button Grid.Column="4"
                        Click="CreatePlace_Click"
                        Width="44" Height="44" Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="14"
                        Margin="6,0,14,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Create place">
                    <Border Width="44" Height="44"
                            Background="{DynamicResource RedeSurfaceActiveBrush}"
                            CornerRadius="14">
                        <TextBlock Text="+"
                                   FontSize="22"
                                   FontWeight="{StaticResource RedeWeightBold}"
                                   Foreground="{Binding OwnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Button>
            </Grid>
        </Border>

    <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
                Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidthConverter}}"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <DockPanel>

                <!-- Sidebar title — shows the active place's name, or "Direct Messages"
                     in Home mode. Right-click on a place title triggers the place
                     context menu (invite / settings / leave / etc.). -->
                <Border DockPanel.Dock="Top" Padding="14,10"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ActivePlace.Name, FallbackValue='Direct Messages', TargetNullValue='Direct Messages'}"
                                   FontSize="{StaticResource RedeBodySize}"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   Foreground="{DynamicResource RedeTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                        <Button Grid.Column="1" Classes="ghost"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="4" Margin="0"
                                Width="28" Height="28"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSidebarCollapsed, Converter={StaticResource CollapseIconConverter}}"
                                       FontSize="14" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Search bar -->
                <Border DockPanel.Dock="Top" Padding="10,6,10,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <TextBox Text="{Binding SearchText}"
                             Watermark="Search..."
                             FontSize="{StaticResource RedeSmallSize}"
                             Padding="10,5"
                             MinHeight="0" />
                </Border>

                <!-- Retry row (only visible when disconnected) -->
                <Border DockPanel.Dock="Top" Padding="10,0,10,6"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        IsVisible="{Binding !IsConnected}">
                    <Button Classes="ghost"
                            Content="Reconnect"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="8,4"
                            FontSize="{StaticResource RedeSmallSize}"
                            Foreground="{DynamicResource RedeAccentVioletBrush}"
                            Click="RetryConnection_Click" />
                </Border>

                <!-- User profile panel (bottom of sidebar, like Discord) -->
                <Border DockPanel.Dock="Bottom" Padding="8,6"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Background="#0cffffff">
                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                        <!-- Avatar with status dot -->
                        <Panel Grid.Column="0" Width="40" Height="40">
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{Binding OwnAccentBrush}"
                                    ClipToBounds="True">
                                <Panel>
                                    <TextBlock Text="{Binding OwnInitial}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasOwnAvatar}" />
                                    <Image Source="{Binding OwnAvatarImage}"
                                           Width="40" Height="40"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasOwnAvatar}" />
                                </Panel>
                            </Border>
                            <Ellipse Width="12" Height="12"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Fill="{Binding OwnStatusBrush}"
                                     Stroke="{DynamicResource RedeSurfaceBrush}"
                                     StrokeThickness="2" />
                        </Panel>
                        <!-- Name + status text -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0"
                                    IsVisible="{Binding !IsSidebarCollapsed}">
                            <TextBlock Text="{Binding OwnDisplayName}"
                                       FontSize="{StaticResource RedeSmallSize}"
                                       FontWeight="{StaticResource RedeWeightMedium}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OwnStatusText}"
                                       Classes="muted"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Settings gear -->
                        <Button Grid.Column="3" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Settings"
                                VerticalAlignment="Center"
                                Click="Settings_Click">
                            <Image Source="{StaticResource IconGear}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable sidebar content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                <!-- ===== ACTIVE PLACE CHANNELS =====
                     Only visible when a place is selected from the top rail (and the
                     sidebar is expanded). Shows the place's channels at the top of the
                     sidebar so the place dominates the view, exactly like Discord. -->
                <StackPanel x:Name="PlaceChannelList"
                            IsVisible="{Binding ShowPlaceChannels}"
                            DragDrop.AllowDrop="True">
                    <!-- Channels section header (with member count) -->
                    <Border Padding="12,10,12,6"
                            IsVisible="{Binding !IsSidebarCollapsed}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Channels" Classes="secondary"
                                       FontWeight="{StaticResource RedeWeightSemiBold}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActivePlace.MemberCount, StringFormat='{}{0} members'}"
                                       Classes="muted"
                                       FontSize="{StaticResource RedeCaptionSize}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Channels list: interleaved category headers + channels (ChannelTree).
                         Drag a channel onto a category header (or another channel) to move it;
                         drop on empty channel-area space to make it uncategorized. -->
                    <ItemsControl ItemsSource="{Binding ActivePlace.ChannelTree}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:CategoryHeaderViewModel" x:DataType="vm:CategoryHeaderViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,6,8,2"
                                        Margin="2,4,2,0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        DragDrop.AllowDrop="True"
                                        Click="CategoryHeader_Click"
                                        PointerPressed="CategoryHeader_PointerPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding ChevronGlyph}" Classes="muted"
                                                   FontSize="{StaticResource RedeCaptionSize}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" Classes="secondary"
                                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                                   FontSize="{StaticResource RedeCaptionSize}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ChannelItemViewModel" x:DataType="vm:ChannelItemViewModel">
                                <Grid ColumnDefinitions="3,*">
                                    <Border Grid.Column="0"
                                            Width="3"
                                            Margin="0,4"
                                            CornerRadius="0,2,2,0"
                                            Background="{DynamicResource RedeAccentVioletBrush}"
                                            IsVisible="{Binding IsSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Classes.sidebar-selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,6"
                                            Margin="2,0"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            DragDrop.AllowDrop="True"
                                            Click="Channel_Click"
                                            PointerPressed="Channel_PointerPressed"
                                            PointerMoved="Channel_PointerMoved">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0">
                                                <Run Text="#" Foreground="{DynamicResource RedeTextMutedBrush}" />
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                                     Fill="{DynamicResource RedeAccentVioletBrush}"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding HasUnread}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== DIRECT MESSAGES (Contacts + Groups) =====
                     Visible only when no place is active. Selecting a place from the top
                     rail hides this entire block; clicking the @ button restores it. -->
                <StackPanel IsVisible="{Binding ShowDirectMessages}">

                <Separator />

                <!-- Contacts header -->
                <Border Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Contacts" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Add contact"
                                Click="AddContact_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Contact list -->
                    <ItemsControl ItemsSource="{Binding Contacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactItemViewModel">
                                <Grid ColumnDefinitions="3,*"
                                      IsVisible="{Binding IsMatch}">
                                    <!-- Selected indicator (Discord-style left accent bar) -->
                                    <Border Grid.Column="0"
                                            Width="3"
                                            Margin="0,6"
                                            CornerRadius="0,2,2,0"
                                            Background="{DynamicResource RedeAccentVioletBrush}"
                                            IsVisible="{Binding IsSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Classes.sidebar-selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,8"
                                            Margin="2,1"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                            CommandParameter="{Binding}"
                                            PointerPressed="Contact_PointerPressed">
                                        <Grid ColumnDefinitions="Auto,8,*,Auto">
                                            <!-- Avatar circle -->
                                            <Panel Grid.Column="0" Width="36" Height="36">
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{Binding AccentBrush}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding !HasAvatar}" />
                                                        <Image Source="{Binding AvatarImage}"
                                                               Width="36" Height="36"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding HasAvatar}" />
                                                    </Panel>
                                                </Border>
                                                <!-- Status indicator -->
                                                <Ellipse Width="10" Height="10"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Fill="{Binding StatusBrush}"
                                                         ToolTip.Tip="{Binding StatusTooltip}" />
                                            </Panel>
                                            <!-- Name -->
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !$parent[ItemsControl].((vm:MainViewModel)DataContext).IsSidebarCollapsed, FallbackValue=True}" />
                                            <!-- Unread dot -->
                                            <Ellipse Grid.Column="3" Width="8" Height="8"
                                                     Fill="{DynamicResource RedeAccentVioletBrush}"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding HasUnread}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Separator />

                <!-- Groups header -->
                <Border Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Groups" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Create group"
                                Click="CreateGroup_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Group list -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                                <Grid ColumnDefinitions="3,*"
                                      IsVisible="{Binding IsMatch}">
                                    <Border Grid.Column="0"
                                            Width="3"
                                            Margin="0,6"
                                            CornerRadius="0,2,2,0"
                                            Background="{DynamicResource RedeAccentVioletBrush}"
                                            IsVisible="{Binding IsSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Classes.sidebar-selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,8"
                                            Margin="2,1"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                            CommandParameter="{Binding}"
                                            PointerPressed="Group_PointerPressed">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0">
                                                <Run Text="#" Foreground="{DynamicResource RedeTextMutedBrush}" />
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                                     Fill="{DynamicResource RedeAccentVioletBrush}"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding HasUnread}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===== CHAT AREA ===== -->
        <DockPanel Grid.Column="1"
                   DragDrop.AllowDrop="True">

            <!-- Chat header — sits below the top place rail. -->
            <Border DockPanel.Dock="Top" Padding="16,12"
                    Background="{DynamicResource RedeSurfaceBrush}"
                    BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChatTitle}"
                                   Classes="header"
                                   IsVisible="{Binding ChatTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding ChannelTopic}"
                                   Classes="muted"
                                   FontSize="{StaticResource RedeCaptionSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"
                                   IsVisible="{Binding ChannelTopic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <!-- Member list toggle (Discord-style "Members" text button —
                         the previous icon used U+1D5E0 which fell back to "?" on systems
                         without the Mathematical Alphanumeric block). -->
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="10,4"
                            CornerRadius="4"
                            ToolTip.Tip="Toggle member list"
                            IsVisible="{Binding IsPlaceSelected}"
                            Click="ToggleMemberList_Click">
                        <TextBlock Text="Members"
                                   FontSize="{StaticResource RedeSmallSize}"
                                   FontWeight="{StaticResource RedeWeightMedium}"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Padding="10,4"
                            CornerRadius="4"
                            ToolTip.Tip="Reset secure session — use after the contact reinstalled or you re-added them"
                            IsVisible="{Binding IsContactSelected}"
                            Click="ResyncContact_Click">
                        <TextBlock Text="Resync"
                                   FontSize="{StaticResource RedeSmallSize}"
                                   FontWeight="{StaticResource RedeWeightMedium}"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="3"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Start voice call"
                            IsVisible="{Binding IsContactSelected}"
                            Click="CallContact_Click">
                        <Image Source="{StaticResource IconMicrophone}" Width="18" Height="18" />
                    </Button>
                    <!-- Group voice call — visible only when a group is selected. -->
                    <Button Grid.Column="4"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Start group voice call"
                            IsVisible="{Binding IsGroupSelected}"
                            Click="CallGroup_Click">
                        <Image Source="{StaticResource IconMicrophone}" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

            <!-- In-chat message search bar (Ctrl+F to open, Esc to close) -->
            <Border DockPanel.Dock="Top"
                    Padding="12,8"
                    Background="{DynamicResource RedeSurfaceBrush}"
                    BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    IsVisible="{Binding IsMessageSearchVisible}">
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="MessageSearchBox"
                             Text="{Binding MessageSearchQuery}"
                             Watermark="Search this conversation..."
                             FontSize="{StaticResource RedeSmallSize}"
                             Padding="10,6"
                             MinHeight="0"
                             KeyDown="MessageSearchBox_KeyDown" />
                    <Button Grid.Column="2" Content="✕"
                            FontSize="14" Padding="8,4"
                            Background="Transparent"
                            Foreground="{DynamicResource RedeSecondaryBrush}"
                            Command="{Binding CloseMessageSearchCommand}" />
                </Grid>
            </Border>

            <!-- Call overlay (above input bar) -->
            <ContentControl DockPanel.Dock="Bottom"
                            x:Name="CallOverlay" />

            <!-- Reply preview bar + Message input bar -->
            <StackPanel DockPanel.Dock="Bottom">
                <!-- Reply preview (shown when replying) -->
                <Border Padding="16,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsReplying}">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Background="{DynamicResource RedeAccentBrush}" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding ReplyToAuthor, StringFormat='Replying to {0}'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RedeAccentBrush}" />
                            <TextBlock Text="{Binding ReplyToPreview}"
                                       FontSize="12"
                                       Foreground="{DynamicResource RedeSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="✕"
                                FontSize="14" Padding="6,2"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Command="{Binding CancelReplyCommand}" />
                    </Grid>
                </Border>
                <!-- Edit preview (shown when editing) -->
                <Border Padding="16,8"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsEditing}">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Background="{DynamicResource RedeAccentTealBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="Editing message"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RedeAccentTealBrush}" />
                        <Button Grid.Column="4" Content="✕"
                                FontSize="14" Padding="6,2"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Command="{Binding CancelEditCommand}" />
                    </Grid>
                </Border>
                <!-- Input bar -->
                <Border Padding="16,12"
                        Background="{DynamicResource RedeSurfaceBrush}"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <Button Grid.Column="0"
                                Content="+"
                                FontSize="18" FontWeight="Bold"
                                Padding="8,4"
                                Background="Transparent"
                                Foreground="{DynamicResource RedeSecondaryBrush}"
                                Click="AttachButton_Click"
                                ToolTip.Tip="Attach file" />
                        <TextBox Grid.Column="2"
                                 x:Name="InputBox"
                                 Text="{Binding InputText}"
                                 Watermark="Type a message or /command..."
                                 MaxLength="4096"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="40"
                                 MaxHeight="240"
                                 VerticalContentAlignment="Center"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="InputBox_KeyDown" />
                        <Button Grid.Column="4"
                                Content="Send"
                                Background="{Binding OwnAccentBrush}"
                                Foreground="White"
                                Command="{Binding SendMessageCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Messages area -->
            <Panel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="MessageScroller">
                <ItemsControl ItemsSource="{Binding Messages}" Padding="16,8"
                              VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <StackPanel Spacing="0" IsVisible="{Binding !IsSearchHidden}">
                            <!-- Day separator (Today / Yesterday / dd MMM yyyy) -->
                            <Grid ColumnDefinitions="*,Auto,*"
                                  Margin="0,12,0,4"
                                  IsVisible="{Binding ShowDateSeparator}">
                                <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                        Background="{DynamicResource RedeBorderSubtleBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DateSeparatorText}"
                                           Margin="10,0"
                                           FontSize="{StaticResource RedeCaptionSize}"
                                           FontWeight="{StaticResource RedeWeightSemiBold}"
                                           Foreground="{DynamicResource RedeTextMutedBrush}" />
                                <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                        Background="{DynamicResource RedeBorderSubtleBrush}" />
                            </Grid>
                            <Border Margin="0,2" Padding="0,4"
                                    Tag="{Binding}"
                                    PointerReleased="MessageItem_PointerReleased">
                                <Grid>
                                    <!-- Security alert (centered, warning color) -->
                                    <Border Background="#1af59e0b"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            HorizontalAlignment="Center"
                                            MaxWidth="500"
                                            IsVisible="{Binding IsSecurityAlert}">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource RedeWarningBrush}"
                                                   FontSize="{StaticResource RedeSmallSize}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- System message (centered) -->
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{DynamicResource RedeTextSecondaryBrush}"
                                               FontStyle="Italic"
                                               FontSize="{StaticResource RedeSmallSize}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsSystem}" />

                                    <!-- Incoming message (left) -->
                                    <!-- Grid (Auto avatar, * content) so the content width is bounded
                                         by the viewport. A horizontal StackPanel measures its children
                                         with infinite width, which defeated TextWrapping on long messages
                                         (they overflowed to the right and got clipped). No fixed MaxWidth:
                                         Discord-style, text wraps at the window-dependent viewport width. -->
                                    <Grid ColumnDefinitions="Auto,*"
                                          Margin="0,0,80,0"
                                          IsVisible="{Binding IsIncoming}">
                                        <!-- Sender avatar (only on first message of a group) -->
                                        <Border Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="20"
                                                Background="{Binding SenderAccentBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Top" Margin="0,20,0,0"
                                                IsVisible="{Binding ShowHeader}">
                                            <Panel>
                                                <TextBlock Text="{Binding SenderInitial}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSenderAvatar}" />
                                                <Image Source="{Binding SenderAvatar}"
                                                       Width="40" Height="40"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasSenderAvatar}" />
                                            </Panel>
                                        </Border>
                                        <!-- Spacer so grouped bubbles stay aligned with the first one -->
                                        <Border Grid.Column="0" Width="40" Height="0"
                                                IsVisible="{Binding !ShowHeader}" />
                                        <StackPanel Grid.Column="1" Spacing="4"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding ShowHeader}">
                                                <TextBlock Text="{Binding From}"
                                                           Foreground="{Binding SenderAccentBrush}"
                                                           FontWeight="{StaticResource RedeWeightSemiBold}"
                                                           FontSize="{StaticResource RedeBodySize}" />
                                                <!-- Role badge -->
                                                <Border CornerRadius="3"
                                                        Padding="5,2"
                                                        Background="{Binding RoleBadgeBrush}"
                                                        IsVisible="{Binding HasSenderRole}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SenderRole}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeString}"
                                                           Classes="muted"
                                                           FontSize="{StaticResource RedeCaptionSize}"
                                                           VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <!-- Reply quote -->
                                            <Border Background="{DynamicResource RedeBorderBrush}"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,0,0,2"
                                                    BorderThickness="2,0,0,0"
                                                    BorderBrush="{DynamicResource RedeAccentBrush}"
                                                    IsVisible="{Binding IsReply}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding ReplyToAuthor}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource RedeAccentBrush}" />
                                                    <TextBlock Text="{Binding ReplyToPreview}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource RedeSurfaceBrush}"
                                                    CornerRadius="4,12,12,12"
                                                    Padding="14,10"
                                                    IsVisible="{Binding ShowTextBubble}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="[message deleted]"
                                                               FontStyle="Italic"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}"
                                                               IsVisible="{Binding IsDeleted}" />
                                                    <controls:MarkdownTextBlock Markdown="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding !IsDeleted}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding IsEdited}">
                                                        <TextBlock Text="(edited)"
                                                                   FontSize="{StaticResource RedeCaptionSize}"
                                                                   Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                                IsVisible="{Binding HasTtl}">
                                                        <Image Source="{StaticResource IconClock}" Width="12" Height="12"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TtlDisplay}"
                                                                   Classes="muted"
                                                                   FontSize="{StaticResource RedeCaptionSize}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <!-- Attachments (incoming) -->
                                            <ItemsControl ItemsSource="{Binding Attachments}"
                                                          IsVisible="{Binding HasAttachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Panel Margin="0,4,0,0">
                                                            <!-- Inline image: clean, no chip framing. DownOnly so a
                                                                 small image keeps its natural size instead of being
                                                                 upscaled into a blurry block. -->
                                                            <Border CornerRadius="10"
                                                                    ClipToBounds="True"
                                                                    HorizontalAlignment="Left"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    PointerReleased="AttachmentItem_Click"
                                                                    IsVisible="{Binding HasPreview}">
                                                                <Image Source="{Binding Preview}"
                                                                       MaxWidth="380" MaxHeight="320"
                                                                       Stretch="Uniform"
                                                                       StretchDirection="DownOnly" />
                                                            </Border>
                                                            <!-- Loading placeholder for an image whose blob is still
                                                                 being fetched/decoded — avoids the file-chip flash. -->
                                                            <Border CornerRadius="10"
                                                                    Width="220" Height="150"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource RedeSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    IsVisible="{Binding ShowLoadingPlaceholder}">
                                                                <TextBlock Text="Loading image…"
                                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <!-- File chip (non-image attachments, or failed images) -->
                                                            <Border CornerRadius="6" Padding="10,8"
                                                                    Background="{DynamicResource RedeSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    PointerReleased="AttachmentItem_Click"
                                                                    IsVisible="{Binding ShowFileChip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               Foreground="{DynamicResource RedeAccentBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="12"
                                                                               Foreground="{DynamicResource RedeSecondaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Reaction pills (incoming) -->
                                            <ItemsControl ItemsSource="{Binding Reactions}"
                                                          IsVisible="{Binding HasReactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10"
                                                                Padding="6,3"
                                                                Margin="0,2,4,0"
                                                                Background="{DynamicResource RedeSurfaceBrush}"
                                                                BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Emoji}" FontSize="13" />
                                                                <TextBlock Text="{Binding Count}" FontSize="12"
                                                                           Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Own message (right). No fixed MaxWidth — wraps at viewport width. -->
                                    <StackPanel Spacing="4"
                                                HorizontalAlignment="Right"
                                                Margin="80,0,0,0"
                                                IsVisible="{Binding IsOwn}">
                                        <!-- Reply quote (own) -->
                                        <Border Background="{DynamicResource RedeBorderBrush}"
                                                CornerRadius="4"
                                                Padding="10,6"
                                                Margin="0,0,0,2"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{DynamicResource RedeAccentBrush}"
                                                IsVisible="{Binding IsReply}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding ReplyToAuthor}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource RedeAccentBrush}" />
                                                <TextBlock Text="{Binding ReplyToPreview}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource RedeSurfaceActiveBrush}"
                                                CornerRadius="12,4,12,12"
                                                Padding="14,10"
                                                IsVisible="{Binding ShowTextBubble}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="[message deleted]"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                           IsVisible="{Binding IsDeleted}" />
                                                <controls:MarkdownTextBlock Markdown="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsDeleted}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding IsEdited}">
                                                    <TextBlock Text="(edited)"
                                                               FontSize="{StaticResource RedeCaptionSize}"
                                                               Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3"
                                                            IsVisible="{Binding HasTtl}">
                                                    <Image Source="{StaticResource IconClock}" Width="12" Height="12"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TtlDisplay}"
                                                               Classes="muted"
                                                               FontSize="{StaticResource RedeCaptionSize}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Attachments (own) -->
                                        <ItemsControl ItemsSource="{Binding Attachments}"
                                                      IsVisible="{Binding HasAttachments}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Panel Margin="0,4,0,0" HorizontalAlignment="Right">
                                                        <!-- Inline image: clean, no chip framing. DownOnly so small
                                                             images aren't upscaled into a blurry block. -->
                                                        <Border CornerRadius="10"
                                                                ClipToBounds="True"
                                                                HorizontalAlignment="Right"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                PointerReleased="AttachmentItem_Click"
                                                                IsVisible="{Binding HasPreview}">
                                                            <Image Source="{Binding Preview}"
                                                                   MaxWidth="380" MaxHeight="320"
                                                                   Stretch="Uniform"
                                                                   StretchDirection="DownOnly" />
                                                        </Border>
                                                        <!-- Loading placeholder while the image blob loads -->
                                                        <Border CornerRadius="10"
                                                                Width="220" Height="150"
                                                                HorizontalAlignment="Right"
                                                                Background="{DynamicResource RedeSurfaceActiveBrush}"
                                                                BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                BorderThickness="1"
                                                                IsVisible="{Binding ShowLoadingPlaceholder}">
                                                            <TextBlock Text="Loading image…"
                                                                       Foreground="{DynamicResource RedeSecondaryBrush}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- File chip (non-image attachments, or failed images) -->
                                                        <Border CornerRadius="6" Padding="10,8"
                                                                Background="{DynamicResource RedeSurfaceActiveBrush}"
                                                                BorderBrush="{DynamicResource RedeBorderBrush}"
                                                                BorderThickness="1"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                PointerReleased="AttachmentItem_Click"
                                                                IsVisible="{Binding ShowFileChip}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{DynamicResource RedeAccentBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="12"
                                                                           Foreground="{DynamicResource RedeSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Reaction pills (own) -->
                                        <ItemsControl ItemsSource="{Binding Reactions}"
                                                      IsVisible="{Binding HasReactions}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10"
                                                            Padding="6,3"
                                                            Margin="0,2,4,0"
                                                            Background="{DynamicResource RedeSurfaceBrush}"
                                                            BorderBrush="{DynamicResource RedeBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Emoji}" FontSize="13" />
                                                            <TextBlock Text="{Binding Count}" FontSize="12"
                                                                       Foreground="{DynamicResource RedeSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right"
                                                    IsVisible="{Binding ShowHeader}">
                                            <TextBlock Text="{Binding TimeString}"
                                                       Classes="muted"
                                                       FontSize="{StaticResource RedeCaptionSize}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- "Newest Messages" scroll-to-bottom button -->
            <Button x:Name="NewestMessagesBtn"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Padding="14,7"
                    Background="{DynamicResource RedeAccentBrush}"
                    Foreground="#ffffff"
                    CornerRadius="14"
                    FontSize="{StaticResource RedeSmallSize}"
                    FontWeight="{StaticResource RedeWeightSemiBold}"
                    Cursor="Hand"
                    Click="NewestMessagesBtn_Click">
                <TextBlock Text="Newest Messages" />
            </Button>
            </Panel>

        </DockPanel>

        <!-- ===== MEMBER LIST PANEL ===== -->
        <Border Grid.Column="2"
                Width="{Binding IsMemberListVisible, Converter={StaticResource SidebarWidthConverter}}"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                IsVisible="{Binding IsMemberListVisible}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,8"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Members" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightSemiBold}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MemberList}" Padding="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceMemberViewModel">
                                <Border Classes="member-row"
                                        Padding="8,4" Margin="0,1" CornerRadius="4"
                                        Cursor="Hand"
                                        PointerPressed="Member_PointerPressed">
                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <!-- Avatar -->
                                        <Panel Grid.Column="0" Width="32" Height="32">
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse Width="9" Height="9"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}" />
                                        </Panel>
                                        <!-- Name -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource RedeSmallSize}" />
                                        </StackPanel>
                                        <!-- Role badge -->
                                        <Border Grid.Column="3" CornerRadius="3"
                                                Padding="5,2" VerticalAlignment="Center"
                                                Background="{Binding RoleBrush}">
                                            <TextBlock Text="{Binding Role}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
    </DockPanel>

    <!-- ===== IMAGE LIGHTBOX =====
         Click on an image attachment opens a centered full-bounds preview.
         Click outside the picture (or press Escape via the global hook) to
         dismiss. Click on the image itself does nothing — Handled=true on
         the inner border eats the bubbling pointer event. -->
    <Border IsVisible="{Binding IsLightboxOpen}"
            Background="#D0000000"
            PointerPressed="Lightbox_PointerPressed">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                ClipToBounds="True"
                BoxShadow="0 12 50 0 #80000000"
                PointerPressed="LightboxImage_PointerPressed">
            <Image Source="{Binding LightboxImage}"
                   Stretch="Uniform"
                   MaxWidth="1600" MaxHeight="1000" />
        </Border>
    </Border>

    <!-- ===== QUICK SWITCHER (Ctrl+K) ===== -->
    <!-- Full-bounds dim layer; click anywhere outside the popup to dismiss. -->
    <Border IsVisible="{Binding IsQuickSwitcherOpen}"
            Background="#A0000000"
            PointerPressed="QuickSwitcherDim_PointerPressed">
        <Border Width="560" MinHeight="80" MaxHeight="500"
                Margin="0,120,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource RedeSurfaceBrush}"
                BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 8 30 0 #80000000"
                Padding="0"
                PointerPressed="QuickSwitcherPopup_PointerPressed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,12,14,10"
                        BorderBrush="{DynamicResource RedeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBox x:Name="QuickSwitcherBox"
                             Text="{Binding QuickSwitcherQuery}"
                             Watermark="Jump to a contact, group, or channel..."
                             FontSize="14"
                             Padding="8,6"
                             MinHeight="0"
                             KeyDown="QuickSwitcherBox_KeyDown" />
                </Border>
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QuickSwitcherResults}" Padding="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickSwitchResultViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,8"
                                        Margin="2,1"
                                        BorderThickness="0"
                                        CornerRadius="6"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).QuickSwitcherPickCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="32,10,*">
                                        <Border Grid.Column="0" Width="32" Height="32"
                                                CornerRadius="6"
                                                Background="{Binding AccentBrush}">
                                            <TextBlock Text="{Binding IconText}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource RedeTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>

    </Panel>
</UserControl>
