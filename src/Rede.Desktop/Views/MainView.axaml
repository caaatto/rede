<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rede.Desktop.ViewModels"
             x:Class="Rede.Desktop.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Panel>
    <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
                Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidthConverter}}"
                Background="{StaticResource RedeSurfaceBrush}"
                BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Spacer for title bar area -->
                <Border DockPanel.Dock="Top" Height="30" Background="Transparent"
                        IsHitTestVisible="False" />

                <!-- Collapse toggle (always at top) -->
                <Border DockPanel.Dock="Top" Padding="4,6" Background="{StaticResource RedeSurfaceBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Status dot + text (hidden when collapsed) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       Classes="secondary"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                            <Button Classes="ghost"
                                    Content="Retry"
                                    Padding="4,2"
                                    FontSize="{StaticResource RedeSmallSize}"
                                    Foreground="{StaticResource RedeAccentVioletBrush}"
                                    IsVisible="{Binding !IsConnected}"
                                    Click="RetryConnection_Click" />
                        </StackPanel>
                        <!-- Toggle button -->
                        <Button Grid.Column="1" Classes="ghost"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="4" Margin="0"
                                Width="28" Height="28"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding IsSidebarCollapsed, Converter={StaticResource CollapseIconConverter}}"
                                       FontSize="14" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Settings button (bottom of sidebar) -->
                <Border DockPanel.Dock="Bottom" Padding="8,8"
                        BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Button Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,6"
                            CornerRadius="6"
                            ToolTip.Tip="Settings"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="{StaticResource IconGear}" Width="16" Height="16"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Settings"
                                       Classes="secondary"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Scrollable sidebar content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                <Separator />

                <!-- Contacts header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Contacts" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Add contact"
                                Click="AddContact_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Contact list -->
                    <ItemsControl ItemsSource="{Binding Contacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactItemViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8"
                                        Margin="2,1"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                        CommandParameter="{Binding}"
                                        PointerPressed="Contact_PointerPressed">
                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <!-- Avatar circle -->
                                        <Panel Grid.Column="0" Width="28" Height="28">
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasAvatar}" />
                                                    <Image Source="{Binding AvatarImage}"
                                                           Width="28" Height="28"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding HasAvatar}" />
                                                </Panel>
                                            </Border>
                                            <!-- Status indicator -->
                                            <Ellipse Width="8" Height="8"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}"
                                                     ToolTip.Tip="{Binding StatusTooltip}" />
                                        </Panel>
                                        <!-- Name -->
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !$parent[Border].((vm:MainViewModel)DataContext).IsSidebarCollapsed, FallbackValue=True}" />
                                        <!-- Unread dot -->
                                        <Ellipse Grid.Column="3" Width="8" Height="8"
                                                 Fill="{StaticResource RedeAccentVioletBrush}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding HasUnread}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Separator />

                <!-- Groups header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Groups" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Create group"
                                Click="CreateGroup_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Group list -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                                <Button Classes="ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8"
                                        Margin="2,1"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectConversationCommand}"
                                        CommandParameter="{Binding}"
                                        PointerPressed="Group_PointerPressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0">
                                            <Run Text="#" Foreground="{StaticResource RedeTextMutedBrush}" />
                                            <Run Text="{Binding Name}" />
                                        </TextBlock>
                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                 Fill="{StaticResource RedeAccentVioletBrush}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding HasUnread}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Separator />

                <!-- Places header -->
                <Border Padding="12,8"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Places" Classes="secondary"
                                   FontWeight="{StaticResource RedeWeightSemiBold}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Padding="4" Width="28" Height="28"
                                ToolTip.Tip="Create place"
                                Click="CreatePlace_Click">
                            <TextBlock Text="+" FontSize="16" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Place list with nested channels -->
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceItemViewModel">
                                <StackPanel>
                                    <!-- Place header -->
                                    <Button Classes="ghost"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,6"
                                            Margin="2,1"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Click="PlaceHeader_Click"
                                            PointerPressed="Place_PointerPressed">
                                        <Grid ColumnDefinitions="Auto,6,Auto,4,*,Auto,Auto">
                                            <!-- Place icon -->
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True" VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasIcon}" />
                                                    <Image Source="{Binding IconImage}"
                                                           Width="24" Height="24"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding HasIcon}" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding IsExpanded, Converter={StaticResource CollapseIconConverter}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource RedeTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4"
                                                       FontWeight="{StaticResource RedeWeightMedium}">
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding MemberCount, StringFormat={}{0}}"
                                                       Classes="muted"
                                                       FontSize="{StaticResource RedeCaptionSize}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <Ellipse Grid.Column="6" Width="8" Height="8"
                                                     Fill="{StaticResource RedeAccentVioletBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0"
                                                     IsVisible="{Binding HasUnread}" />
                                        </Grid>
                                    </Button>
                                    <!-- Channels (visible when expanded) — grouped by category -->
                                    <ItemsControl ItemsSource="{Binding Channels}"
                                                  IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChannelItemViewModel">
                                                <Button Classes="ghost"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="24,6,12,6"
                                                        Margin="2,0"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Click="Channel_Click"
                                                        PointerPressed="Channel_PointerPressed">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0">
                                                            <Run Text="#" Foreground="{StaticResource RedeTextMutedBrush}" />
                                                            <Run Text="{Binding Name}" />
                                                        </TextBlock>
                                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                                 Fill="{StaticResource RedeAccentVioletBrush}"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding HasUnread}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===== CHAT AREA ===== -->
        <DockPanel Grid.Column="1">

            <!-- Chat header (extra top margin for title bar) -->
            <Border DockPanel.Dock="Top" Padding="16,12" Margin="0,30,0,0"
                    Background="{StaticResource RedeSurfaceBrush}"
                    BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChatTitle}"
                                   Classes="header"
                                   IsVisible="{Binding ChatTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding ChannelTopic}"
                                   Classes="muted"
                                   FontSize="{StaticResource RedeCaptionSize}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"
                                   IsVisible="{Binding ChannelTopic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <!-- Member list toggle -->
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Toggle member list"
                            IsVisible="{Binding IsPlaceSelected}"
                            Click="ToggleMemberList_Click">
                        <TextBlock Text="&#x1D5E0;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Start voice call"
                            IsVisible="{Binding IsContactSelected}"
                            Click="CallContact_Click">
                        <Image Source="{StaticResource IconMicrophone}" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

            <!-- Call overlay (above input bar) -->
            <ContentControl DockPanel.Dock="Bottom"
                            x:Name="CallOverlay" />

            <!-- Message input bar -->
            <Border DockPanel.Dock="Bottom" Padding="16,12"
                    Background="{StaticResource RedeSurfaceBrush}"
                    BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding InputText}"
                             Watermark="Type a message or /command..."
                             MaxLength="4096"
                             KeyDown="InputBox_KeyDown" />
                    <Button Grid.Column="2"
                            Content="Send"
                            Command="{Binding SendMessageCommand}" />
                </Grid>
            </Border>

            <!-- Messages area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="MessageScroller">
                <ItemsControl ItemsSource="{Binding Messages}" Padding="16,8"
                              VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Border Margin="0,2" Padding="0,4">
                                <Grid>
                                    <!-- Security alert (centered, warning color) -->
                                    <Border Background="#1af59e0b"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            HorizontalAlignment="Center"
                                            MaxWidth="500"
                                            IsVisible="{Binding IsSecurityAlert}">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{StaticResource RedeWarningBrush}"
                                                   FontSize="{StaticResource RedeSmallSize}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- System message (centered) -->
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{StaticResource RedeTextSecondaryBrush}"
                                               FontStyle="Italic"
                                               FontSize="{StaticResource RedeSmallSize}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsSystem}" />

                                    <!-- Incoming message (left) -->
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,80,0"
                                                MaxWidth="540"
                                                IsVisible="{Binding !IsOwn}">
                                        <!-- Sender avatar -->
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{Binding SenderAccentBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Top" Margin="0,18,0,0"
                                                IsVisible="{Binding !IsSystem}">
                                            <Panel>
                                                <TextBlock Text="{Binding SenderInitial}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSenderAvatar}" />
                                                <Image Source="{Binding SenderAvatar}"
                                                       Width="32" Height="32"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasSenderAvatar}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Spacing="2" MaxWidth="500">
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding !IsSystem}">
                                                <TextBlock Text="{Binding From}"
                                                           Foreground="{Binding SenderAccentBrush}"
                                                           FontWeight="{StaticResource RedeWeightMedium}"
                                                           FontSize="{StaticResource RedeSmallSize}" />
                                                <!-- Role badge -->
                                                <Border CornerRadius="3"
                                                        Padding="4,1"
                                                        Background="{Binding RoleBadgeBrush}"
                                                        IsVisible="{Binding HasSenderRole}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SenderRole}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeString}"
                                                           Classes="muted"
                                                           FontSize="{StaticResource RedeCaptionSize}"
                                                           VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <Border Background="{StaticResource RedeSurfaceBrush}"
                                                    CornerRadius="4,12,12,12"
                                                    Padding="12,8"
                                                    IsVisible="{Binding !IsSystem}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Text}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                                VerticalAlignment="Bottom"
                                                                IsVisible="{Binding HasTtl}">
                                                        <Image Source="{StaticResource IconClock}" Width="11" Height="11"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TtlDisplay}"
                                                                   Classes="muted"
                                                                   FontSize="{StaticResource RedeCaptionSize}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Own message (right) -->
                                    <StackPanel Spacing="2"
                                                HorizontalAlignment="Right"
                                                Margin="80,0,0,0"
                                                MaxWidth="500"
                                                IsVisible="{Binding IsOwn}">
                                        <Border Background="{StaticResource RedeSurfaceActiveBrush}"
                                                CornerRadius="12,4,12,12"
                                                Padding="12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="3"
                                                            VerticalAlignment="Bottom"
                                                            IsVisible="{Binding HasTtl}">
                                                    <Image Source="{StaticResource IconClock}" Width="11" Height="11"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TtlDisplay}"
                                                               Classes="muted"
                                                               FontSize="{StaticResource RedeCaptionSize}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TimeString}"
                                                       Classes="muted"
                                                       FontSize="{StaticResource RedeCaptionSize}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

        <!-- ===== MEMBER LIST PANEL ===== -->
        <Border Grid.Column="2"
                Width="{Binding IsMemberListVisible, Converter={StaticResource SidebarWidthConverter}}"
                Background="{StaticResource RedeSurfaceBrush}"
                BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                IsVisible="{Binding IsMemberListVisible}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="30" Background="Transparent" IsHitTestVisible="False" />
                <Border DockPanel.Dock="Top" Padding="12,8"
                        BorderBrush="{StaticResource RedeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Members" Classes="secondary"
                               FontWeight="{StaticResource RedeWeightSemiBold}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MemberList}" Padding="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaceMemberViewModel">
                                <Border Padding="8,4" Margin="0,1" CornerRadius="4"
                                        PointerPressed="Member_PointerPressed">
                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <!-- Avatar -->
                                        <Panel Grid.Column="0" Width="24" Height="24">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse Width="7" Height="7"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}" />
                                        </Panel>
                                        <!-- Name -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource RedeSmallSize}" />
                                        </StackPanel>
                                        <!-- Role badge -->
                                        <Border Grid.Column="3" CornerRadius="3"
                                                Padding="4,1" VerticalAlignment="Center"
                                                Background="{Binding RoleBrush}">
                                            <TextBlock Text="{Binding Role}"
                                                       FontSize="9" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>

    <!-- App icon — fixed top-left, always visible -->
    <Border Width="30" Height="30"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False">
        <Image Source="avares://Rede.Desktop/Assets/icon.png"
               Width="18" Height="18"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    </Panel>
</UserControl>
