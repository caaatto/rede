<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font sizes -->
    <x:Double x:Key="RedeBodySize">13</x:Double>
    <x:Double x:Key="RedeSmallSize">11</x:Double>
    <x:Double x:Key="RedeHeaderSize">15</x:Double>
    <x:Double x:Key="RedeTitleSize">18</x:Double>
    <x:Double x:Key="RedeCaptionSize">10</x:Double>

    <!-- Font weights -->
    <FontWeight x:Key="RedeWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="RedeWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="RedeWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="RedeWeightBold">Bold</FontWeight>

</ResourceDictionary>
