<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Rede.Desktop.Converters"
             x:Class="Rede.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Colors.axaml" />
                <ResourceInclude Source="/Themes/Typography.axaml" />
                <ResourceInclude Source="/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:SidebarWidthConverter x:Key="SidebarWidthConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
            <conv:CollapseIconConverter x:Key="CollapseIconConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/RedeTheme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.png"
                      ToolTipText="Rede"
                      Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Rede" Click="TrayShow_Click" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="TrayQuit_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
