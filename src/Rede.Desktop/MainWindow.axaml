<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Rede.Desktop.Views"
        xmlns:vm="using:Rede.Desktop.ViewModels"
        x:Class="Rede.Desktop.MainWindow"
        Title="Rede"
        MinWidth="800" MinHeight="550"
        Background="{DynamicResource RedeBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Rede.Desktop/Assets/icon.png"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        KeyDown="Window_KeyDown">

    <Panel>
        <!-- Stretch hosted views to the window bounds so their internal ScrollViewers are
             height-constrained and scroll instead of overflowing off-screen. -->
        <ContentControl x:Name="RootContent"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <!-- Title-bar drag strip. The window is chromeless
             (ExtendClientAreaToDecorationsHint) so the top 36px has no OS drag
             region — this transparent strip provides it. It sits above the
             content but below the OS caption buttons, and all interactive
             content (place rail icons, etc.) lives at y>=36 so nothing is
             blocked. Double-click toggles maximize, like a real title bar. -->
        <Border x:Name="TitleBarDragStrip"
                VerticalAlignment="Top"
                Height="36"
                Background="Transparent"
                PointerPressed="TitleBarDrag_PointerPressed"
                DoubleTapped="TitleBarDrag_DoubleTapped" />
    </Panel>
</Window>
